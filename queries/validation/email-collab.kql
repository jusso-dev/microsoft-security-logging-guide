// Validation query pack: Email and collaboration
// Checks freshness (Rows, Latest, AgeHours) and 7-day volume (GB) for documented Email and collaboration tables.
// Run in: Defender portal > Investigation & response > Advanced hunting (Sentinel workspace selected) or Log Analytics Logs.
// Note: Email*, UrlClickEvents, Message* and CallActivityEvents stay in Defender XDR advanced hunting unless raw streaming is enabled.
let ExpectedTables = datatable(Table: string, MaxSilentHours: int) [
    "OfficeActivity", 2,
    "EmailEvents", 4,
    "EmailPostDeliveryEvents", 24,
    "EmailUrlInfo", 4,
    "EmailAttachmentInfo", 4,
    "UrlClickEvents", 24,
    "CloudAppEvents", 4,
    "SecurityAlert", 24,
    "SecurityIncident", 24,
    "SentinelHealth", 4
];
let Freshness = union withsource=Table isfuzzy=true
    OfficeActivity, EmailEvents, EmailPostDeliveryEvents, EmailUrlInfo, EmailAttachmentInfo, UrlClickEvents, CloudAppEvents, SecurityAlert, SecurityIncident, SentinelHealth
    | where TimeGenerated > ago(7d)
    | summarize Rows24h = countif(TimeGenerated > ago(24h)), Rows7d = count(), Latest = max(TimeGenerated) by Table;
let Volume = Usage
    | where TimeGenerated > ago(7d)
    | where DataType in ("OfficeActivity", "EmailEvents", "EmailPostDeliveryEvents", "EmailUrlInfo", "EmailAttachmentInfo", "UrlClickEvents", "CloudAppEvents", "SecurityAlert", "SecurityIncident", "SentinelHealth")
    | summarize GB7d = round(sum(Quantity) / 1000.0, 3), DailyAvgGB = round(sum(Quantity) / 1000.0 / 7.0, 3) by Table = DataType;
ExpectedTables
| join kind=leftouter Freshness on Table
| join kind=leftouter Volume on Table
| extend
    Rows24h = coalesce(Rows24h, 0),
    Rows7d = coalesce(Rows7d, 0),
    AgeHours = iff(isnotempty(Latest), round((now() - Latest) / 1h, 1), real(null)),
    GB7d = coalesce(GB7d, 0.0),
    DailyAvgGB = coalesce(DailyAvgGB, 0.0)
| extend Status = case(
    Rows7d == 0, "NO_DATA_7D",
    AgeHours > MaxSilentHours, "STALE",
    "OK"
)
| project Table, Status, Rows24h, Rows7d, Latest, AgeHours, MaxSilentHours, DailyAvgGB, GB7d
| order by Status asc, Table asc
