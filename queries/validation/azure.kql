// Validation query pack: Azure workloads and networking
// Checks freshness (Rows, Latest, AgeHours) and 7-day volume (GB) for documented Azure workloads and networking tables.
// Run in: Defender portal > Investigation & response > Advanced hunting (Sentinel workspace selected) or Log Analytics Logs.
// Note: Tables configured as Data lake tier only will not return rows in the Analytics workspace union; check them in Data lake explorer.
let ExpectedTables = datatable(Table: string, MaxSilentHours: int) [
    "AzureActivity", 2,
    "SecurityAlert", 24,
    "SecurityRecommendation", 24,
    "SecureScores", 24,
    "SecurityRegulatoryCompliance", 24,
    "AZKVAuditLogs", 4,
    "AzureDiagnostics", 4,
    "StorageBlobLogs", 4,
    "StorageFileLogs", 24,
    "StorageQueueLogs", 24,
    "StorageTableLogs", 24,
    "AKSAuditAdmin", 4,
    "AKSAudit", 24,
    "AKSControlPlane", 24,
    "ContainerLogV2", 4,
    "AZFWThreatIntel", 24,
    "AZFWIdpsSignature", 24,
    "AZFWNetworkRule", 4,
    "AZFWApplicationRule", 4,
    "AZFWNatRule", 24,
    "AZFWDnsQuery", 4,
    "NTANetAnalytics", 4,
    "AGWFirewallLogs", 24,
    "AGWAccessLogs", 4,
    "DNSQueryLogs", 4,
    "AppServiceAuditLogs", 24,
    "AppServiceIPSecAuditLogs", 24,
    "AppServiceHTTPLogs", 4,
    "FunctionAppLogs", 4
];
let Freshness = union withsource=Table isfuzzy=true
    AzureActivity, SecurityAlert, SecurityRecommendation, SecureScores, SecurityRegulatoryCompliance, AZKVAuditLogs, AzureDiagnostics, StorageBlobLogs, StorageFileLogs, StorageQueueLogs, StorageTableLogs, AKSAuditAdmin, AKSAudit, AKSControlPlane, ContainerLogV2, AZFWThreatIntel, AZFWIdpsSignature, AZFWNetworkRule, AZFWApplicationRule, AZFWNatRule, AZFWDnsQuery, NTANetAnalytics, AGWFirewallLogs, AGWAccessLogs, DNSQueryLogs, AppServiceAuditLogs, AppServiceIPSecAuditLogs, AppServiceHTTPLogs, FunctionAppLogs
    | where TimeGenerated > ago(7d)
    | summarize Rows24h = countif(TimeGenerated > ago(24h)), Rows7d = count(), Latest = max(TimeGenerated) by Table;
let Volume = Usage
    | where TimeGenerated > ago(7d)
    | where DataType in ("AzureActivity", "SecurityAlert", "SecurityRecommendation", "SecureScores", "SecurityRegulatoryCompliance", "AZKVAuditLogs", "AzureDiagnostics", "StorageBlobLogs", "StorageFileLogs", "StorageQueueLogs", "StorageTableLogs", "AKSAuditAdmin", "AKSAudit", "AKSControlPlane", "ContainerLogV2", "AZFWThreatIntel", "AZFWIdpsSignature", "AZFWNetworkRule", "AZFWApplicationRule", "AZFWNatRule", "AZFWDnsQuery", "NTANetAnalytics", "AGWFirewallLogs", "AGWAccessLogs", "DNSQueryLogs", "AppServiceAuditLogs", "AppServiceIPSecAuditLogs", "AppServiceHTTPLogs", "FunctionAppLogs")
    | summarize GB7d = round(sum(Quantity) / 1000.0, 3), DailyAvgGB = round(sum(Quantity) / 1000.0 / 7.0, 3) by Table = DataType;
ExpectedTables
| join kind=leftouter Freshness on Table
| join kind=leftouter Volume on Table
| extend
    Rows24h = coalesce(Rows24h, 0),
    Rows7d = coalesce(Rows7d, 0),
    AgeHours = iff(isnotempty(Latest), round((now() - Latest) / 1h, 1), real(null)),
    GB7d = coalesce(GB7d, 0.0),
    DailyAvgGB = coalesce(DailyAvgGB, 0.0)
| extend Status = case(
    Rows7d == 0, "NO_DATA_7D",
    AgeHours > MaxSilentHours, "STALE",
    "OK"
)
| project Table, Status, Rows24h, Rows7d, Latest, AgeHours, MaxSilentHours, DailyAvgGB, GB7d
| order by Status asc, Table asc
