// Validation query pack: Endpoint
// Checks freshness (Rows, Latest, AgeHours) and 7-day volume (GB) for documented Endpoint tables.
// Run in: Defender portal > Investigation & response > Advanced hunting (Sentinel workspace selected) or Log Analytics Logs.
// Note: Device* tables only appear in Sentinel if Defender XDR raw event streaming is enabled; otherwise query them directly in Defender XDR advanced hunting.
let ExpectedTables = datatable(Table: string, MaxSilentHours: int) [
    "SecurityAlert", 24,
    "SecurityIncident", 24,
    "AlertInfo", 24,
    "AlertEvidence", 24,
    "SecurityEvent", 1,
    "WindowsEvent", 4,
    "Event", 4,
    "IntuneAuditLogs", 24,
    "IntuneOperationalLogs", 24,
    "IntuneDevices", 48,
    "IntuneDeviceComplianceOrg", 48,
    "DeviceProcessEvents", 4,
    "DeviceNetworkEvents", 4,
    "DeviceFileEvents", 4,
    "DeviceLogonEvents", 4,
    "DeviceEvents", 4
];
let Freshness = union withsource=Table isfuzzy=true
    SecurityAlert, SecurityIncident, AlertInfo, AlertEvidence, SecurityEvent, WindowsEvent, Event, IntuneAuditLogs, IntuneOperationalLogs, IntuneDevices, IntuneDeviceComplianceOrg, DeviceProcessEvents, DeviceNetworkEvents, DeviceFileEvents, DeviceLogonEvents, DeviceEvents
    | where TimeGenerated > ago(7d)
    | summarize Rows24h = countif(TimeGenerated > ago(24h)), Rows7d = count(), Latest = max(TimeGenerated) by Table;
let Volume = Usage
    | where TimeGenerated > ago(7d)
    | where DataType in ("SecurityAlert", "SecurityIncident", "AlertInfo", "AlertEvidence", "SecurityEvent", "WindowsEvent", "Event", "IntuneAuditLogs", "IntuneOperationalLogs", "IntuneDevices", "IntuneDeviceComplianceOrg", "DeviceProcessEvents", "DeviceNetworkEvents", "DeviceFileEvents", "DeviceLogonEvents", "DeviceEvents")
    | summarize GB7d = round(sum(Quantity) / 1000.0, 3), DailyAvgGB = round(sum(Quantity) / 1000.0 / 7.0, 3) by Table = DataType;
ExpectedTables
| join kind=leftouter Freshness on Table
| join kind=leftouter Volume on Table
| extend
    Rows24h = coalesce(Rows24h, 0),
    Rows7d = coalesce(Rows7d, 0),
    AgeHours = iff(isnotempty(Latest), round((now() - Latest) / 1h, 1), real(null)),
    GB7d = coalesce(GB7d, 0.0),
    DailyAvgGB = coalesce(DailyAvgGB, 0.0)
| extend Status = case(
    Rows7d == 0, "NO_DATA_7D",
    AgeHours > MaxSilentHours, "STALE",
    "OK"
)
| project Table, Status, Rows24h, Rows7d, Latest, AgeHours, MaxSilentHours, DailyAvgGB, GB7d
| order by Status asc, Table asc
