// Master validation query: is every documented Sentinel table landing?
// Checks freshness, 24h/7d row counts and 7-day volume across every Analytics-tier table in the guide.
// Run in: Defender portal > Investigation & response > Advanced hunting (Sentinel workspace selected) or Log Analytics Logs.
// Trim ExpectedTables to the connectors you actually use before turning this into a scheduled alert rule.
// Note: Tables set to Data lake tier only do not appear in workspace Analytics unions; inspect them in Data lake explorer.
let ExpectedTables = datatable(Table: string, Group: string, MaxSilentHours: int) [
    "AADManagedIdentitySignInLogs", "identity", 24,
    "AADNonInteractiveUserSignInLogs", "identity", 1,
    "AADProvisioningLogs", "identity", 24,
    "AADRiskyServicePrincipals", "identity", 168,
    "AADRiskyUsers", "identity", 168,
    "AADServicePrincipalRiskEvents", "identity", 168,
    "AADServicePrincipalSignInLogs", "identity", 4,
    "AADUserRiskEvents", "identity", 168,
    "ADFSSignInLogs", "identity", 24,
    "ADOAuditLogs_CL", "devops", 24,
    "AGWAccessLogs", "azure", 4,
    "AGWFirewallLogs", "azure", 24,
    "AKSAudit", "azure", 24,
    "AKSAuditAdmin", "azure", 4,
    "AKSControlPlane", "azure", 24,
    "ASimDnsActivityLogs", "servers", 4,
    "AWSCloudTrail", "multi-cloud", 4,
    "AWSCloudWatch", "multi-cloud", 24,
    "AWSGuardDuty", "multi-cloud", 24,
    "AWSNetworkFirewall", "multi-cloud", 24,
    "AWSVPCFlow", "multi-cloud", 4,
    "AZFWApplicationRule", "azure", 4,
    "AZFWDnsQuery", "azure", 4,
    "AZFWIdpsSignature", "azure", 24,
    "AZFWNatRule", "azure", 24,
    "AZFWNetworkRule", "azure", 4,
    "AZFWThreatIntel", "azure", 24,
    "AZKVAuditLogs", "azure", 4,
    "AlertEvidence", "endpoint", 24,
    "AlertInfo", "endpoint", 24,
    "AppServiceAuditLogs", "azure", 24,
    "AppServiceHTTPLogs", "azure", 4,
    "AppServiceIPSecAuditLogs", "azure", 24,
    "AuditLogs", "identity", 4,
    "AzureActivity", "azure", 2,
    "AzureDevOpsAuditing", "devops", 24,
    "AzureDiagnostics", "azure", 4,
    "CloudAppEvents", "email-collab", 4,
    "CommonSecurityLog", "servers", 1,
    "ContainerLogV2", "azure", 4,
    "CopilotActivity", "business-apps", 4,
    "DNSQueryLogs", "azure", 4,
    "DataverseActivity", "business-apps", 4,
    "DeviceEvents", "endpoint", 4,
    "DeviceFileEvents", "endpoint", 4,
    "DeviceLogonEvents", "endpoint", 4,
    "DeviceNetworkEvents", "endpoint", 4,
    "DeviceProcessEvents", "endpoint", 4,
    "EmailAttachmentInfo", "email-collab", 4,
    "EmailEvents", "email-collab", 4,
    "EmailPostDeliveryEvents", "email-collab", 24,
    "EmailUrlInfo", "email-collab", 4,
    "Event", "endpoint", 4,
    "FinanceOperationsActivity_CL", "business-apps", 24,
    "FunctionAppLogs", "azure", 4,
    "GCPAuditLogs", "multi-cloud", 4,
    "GCPDNS", "multi-cloud", 4,
    "GCPVPCFlow", "multi-cloud", 4,
    "GitHubAdvancedSecurityAlerts_CL", "devops", 168,
    "GitHubAuditLogsV2_CL", "devops", 24,
    "GitHubAuditLogsV3_CL", "devops", 24,
    "GoogleCloudSCC", "multi-cloud", 24,
    "IdentityInfo", "identity", 24,
    "IntuneAuditLogs", "endpoint", 24,
    "IntuneDeviceComplianceOrg", "endpoint", 48,
    "IntuneDevices", "endpoint", 48,
    "IntuneOperationalLogs", "endpoint", 24,
    "LAQueryLogs", "sentinel-health", 24,
    "MDCFileIntegrityMonitoringEvents", "servers", 24,
    "McasShadowItReporting", "cloud-apps", 24,
    "MicrosoftGraphActivityLogs", "identity", 4,
    "MicrosoftPurviewInformationProtection", "data-security", 24,
    "NTANetAnalytics", "azure", 4,
    "NetworkAccessTraffic", "identity", 4,
    "OfficeActivity", "email-collab", 2,
    "PowerAutomateActivity", "business-apps", 24,
    "PowerPlatformAdminActivity", "business-apps", 24,
    "RemoteNetworkHealthLogs", "identity", 4,
    "SecureScores", "azure", 24,
    "SecurityAlert", "identity", 24,
    "SecurityEvent", "identity", 1,
    "SecurityIncident", "identity", 24,
    "SecurityRecommendation", "azure", 24,
    "SecurityRegulatoryCompliance", "azure", 24,
    "SentinelAudit", "sentinel-health", 24,
    "SentinelHealth", "sentinel-health", 4,
    "SigninLogs", "identity", 1,
    "StorageBlobLogs", "azure", 4,
    "StorageFileLogs", "azure", 24,
    "StorageQueueLogs", "azure", 24,
    "StorageTableLogs", "azure", 24,
    "Syslog", "servers", 1,
    "UrlClickEvents", "email-collab", 24,
    "W3CIISLog", "servers", 4,
    "WindowsEvent", "endpoint", 4
];
let Freshness = union withsource=Table isfuzzy=true
    AADManagedIdentitySignInLogs,
    AADNonInteractiveUserSignInLogs,
    AADProvisioningLogs,
    AADRiskyServicePrincipals,
    AADRiskyUsers,
    AADServicePrincipalRiskEvents,
    AADServicePrincipalSignInLogs,
    AADUserRiskEvents,
    ADFSSignInLogs,
    ADOAuditLogs_CL,
    AGWAccessLogs,
    AGWFirewallLogs,
    AKSAudit,
    AKSAuditAdmin,
    AKSControlPlane,
    ASimDnsActivityLogs,
    AWSCloudTrail,
    AWSCloudWatch,
    AWSGuardDuty,
    AWSNetworkFirewall,
    AWSVPCFlow,
    AZFWApplicationRule,
    AZFWDnsQuery,
    AZFWIdpsSignature,
    AZFWNatRule,
    AZFWNetworkRule,
    AZFWThreatIntel,
    AZKVAuditLogs,
    AlertEvidence,
    AlertInfo,
    AppServiceAuditLogs,
    AppServiceHTTPLogs,
    AppServiceIPSecAuditLogs,
    AuditLogs,
    AzureActivity,
    AzureDevOpsAuditing,
    AzureDiagnostics,
    CloudAppEvents,
    CommonSecurityLog,
    ContainerLogV2,
    CopilotActivity,
    DNSQueryLogs,
    DataverseActivity,
    DeviceEvents,
    DeviceFileEvents,
    DeviceLogonEvents,
    DeviceNetworkEvents,
    DeviceProcessEvents,
    EmailAttachmentInfo,
    EmailEvents,
    EmailPostDeliveryEvents,
    EmailUrlInfo,
    Event,
    FinanceOperationsActivity_CL,
    FunctionAppLogs,
    GCPAuditLogs,
    GCPDNS,
    GCPVPCFlow,
    GitHubAdvancedSecurityAlerts_CL,
    GitHubAuditLogsV2_CL,
    GitHubAuditLogsV3_CL,
    GoogleCloudSCC,
    IdentityInfo,
    IntuneAuditLogs,
    IntuneDeviceComplianceOrg,
    IntuneDevices,
    IntuneOperationalLogs,
    LAQueryLogs,
    MDCFileIntegrityMonitoringEvents,
    McasShadowItReporting,
    MicrosoftGraphActivityLogs,
    MicrosoftPurviewInformationProtection,
    NTANetAnalytics,
    NetworkAccessTraffic,
    OfficeActivity,
    PowerAutomateActivity,
    PowerPlatformAdminActivity,
    RemoteNetworkHealthLogs,
    SecureScores,
    SecurityAlert,
    SecurityEvent,
    SecurityIncident,
    SecurityRecommendation,
    SecurityRegulatoryCompliance,
    SentinelAudit,
    SentinelHealth,
    SigninLogs,
    StorageBlobLogs,
    StorageFileLogs,
    StorageQueueLogs,
    StorageTableLogs,
    Syslog,
    UrlClickEvents,
    W3CIISLog,
    WindowsEvent
    | where TimeGenerated > ago(7d)
    | summarize Rows24h = countif(TimeGenerated > ago(24h)), Rows7d = count(), Latest = max(TimeGenerated) by Table;
let Volume = Usage
    | where TimeGenerated > ago(7d)
    | summarize GB7d = round(sum(Quantity) / 1000.0, 3), DailyAvgGB = round(sum(Quantity) / 1000.0 / 7.0, 3), IsBillable = any(IsBillable) by Table = DataType;
ExpectedTables
| join kind=leftouter Freshness on Table
| join kind=leftouter Volume on Table
| extend
    Rows24h = coalesce(Rows24h, 0),
    Rows7d = coalesce(Rows7d, 0),
    AgeHours = iff(isnotempty(Latest), round((now() - Latest) / 1h, 1), real(null)),
    GB7d = coalesce(GB7d, 0.0),
    DailyAvgGB = coalesce(DailyAvgGB, 0.0)
| extend Status = case(
    Rows7d == 0, "NO_DATA_7D",
    AgeHours > MaxSilentHours, "STALE",
    "OK"
)
| project Group, Table, Status, Rows24h, Rows7d, Latest, AgeHours, MaxSilentHours, DailyAvgGB, GB7d, IsBillable
| order by Status asc, Group asc, Table asc
