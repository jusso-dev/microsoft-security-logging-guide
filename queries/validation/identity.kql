// Validation query pack: Identity
// Checks freshness (Rows, Latest, AgeHours) and 7-day volume (GB) for documented Identity tables.
// Run in: Defender portal > Investigation & response > Advanced hunting (Sentinel workspace selected) or Log Analytics Logs.
// Note: Defender XDR native tables (EntraIdSignInEvents, EntraIdSpnSignInEvents, IdentityLogonEvents, IdentityQueryEvents, IdentityDirectoryEvents) live in Defender XDR advanced hunting unless streamed.
let ExpectedTables = datatable(Table: string, MaxSilentHours: int) [
    "SigninLogs", 1,
    "AADNonInteractiveUserSignInLogs", 1,
    "AADServicePrincipalSignInLogs", 4,
    "AADManagedIdentitySignInLogs", 24,
    "AuditLogs", 4,
    "AADProvisioningLogs", 24,
    "MicrosoftGraphActivityLogs", 4,
    "ADFSSignInLogs", 24,
    "AADUserRiskEvents", 168,
    "AADRiskyUsers", 168,
    "AADServicePrincipalRiskEvents", 168,
    "AADRiskyServicePrincipals", 168,
    "SecurityEvent", 1,
    "SecurityAlert", 24,
    "SecurityIncident", 24,
    "IdentityInfo", 24,
    "NetworkAccessTraffic", 4,
    "RemoteNetworkHealthLogs", 4
];
let Freshness = union withsource=Table isfuzzy=true
    SigninLogs, AADNonInteractiveUserSignInLogs, AADServicePrincipalSignInLogs, AADManagedIdentitySignInLogs, AuditLogs, AADProvisioningLogs, MicrosoftGraphActivityLogs, ADFSSignInLogs, AADUserRiskEvents, AADRiskyUsers, AADServicePrincipalRiskEvents, AADRiskyServicePrincipals, SecurityEvent, SecurityAlert, SecurityIncident, IdentityInfo, NetworkAccessTraffic, RemoteNetworkHealthLogs
    | where TimeGenerated > ago(7d)
    | summarize Rows24h = countif(TimeGenerated > ago(24h)), Rows7d = count(), Latest = max(TimeGenerated) by Table;
let Volume = Usage
    | where TimeGenerated > ago(7d)
    | where DataType in ("SigninLogs", "AADNonInteractiveUserSignInLogs", "AADServicePrincipalSignInLogs", "AADManagedIdentitySignInLogs", "AuditLogs", "AADProvisioningLogs", "MicrosoftGraphActivityLogs", "ADFSSignInLogs", "AADUserRiskEvents", "AADRiskyUsers", "AADServicePrincipalRiskEvents", "AADRiskyServicePrincipals", "SecurityEvent", "SecurityAlert", "SecurityIncident", "IdentityInfo", "NetworkAccessTraffic", "RemoteNetworkHealthLogs")
    | summarize GB7d = round(sum(Quantity) / 1000.0, 3), DailyAvgGB = round(sum(Quantity) / 1000.0 / 7.0, 3) by Table = DataType;
ExpectedTables
| join kind=leftouter Freshness on Table
| join kind=leftouter Volume on Table
| extend
    Rows24h = coalesce(Rows24h, 0),
    Rows7d = coalesce(Rows7d, 0),
    AgeHours = iff(isnotempty(Latest), round((now() - Latest) / 1h, 1), real(null)),
    GB7d = coalesce(GB7d, 0.0),
    DailyAvgGB = coalesce(DailyAvgGB, 0.0)
| extend Status = case(
    Rows7d == 0, "NO_DATA_7D",
    AgeHours > MaxSilentHours, "STALE",
    "OK"
)
| project Table, Status, Rows24h, Rows7d, Latest, AgeHours, MaxSilentHours, DailyAvgGB, GB7d
| order by Status asc, Table asc
